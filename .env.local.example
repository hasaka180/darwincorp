# ──────────────────────────────────────────────────────────────
# Darwin Corp — environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────

# Public site URL (metadata / absolute links)
NEXT_PUBLIC_SITE_URL=https://thedarwin.co

# Spline hero scene (already in use)
NEXT_PUBLIC_SPLINE_SCENE=https://prod.spline.design/ZxF4urNm-snNBqhQ/scene.splinecode

# ── Studio (admin dashboard) ──────────────────────────────────
# Password that unlocks /studio. Pick something strong.
STUDIO_PASSWORD=

# ── Appwrite (content database) ───────────────────────────────
# Appwrite Console → your project.
#  ENDPOINT: Cloud = https://cloud.appwrite.io/v1 (or https://<region>.cloud.appwrite.io/v1),
#            or your self-hosted URL ending in /v1
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
#  Project Settings → Project ID
APPWRITE_PROJECT_ID=
#  Overview → Integrations → API Keys → create a server key with scopes:
#    databases.read/write, tables.read/write, documents.read/write
APPWRITE_API_KEY=
#  Databases → create a database → copy its ID
APPWRITE_DATABASE_ID=
#  In that database, create a Table/Collection with these 3 attributes:
#    slug   (String, required)
#    title  (String, required)
#    data   (String, size 1000000)   ← stores the whole item as JSON
#  → copy the Table/Collection ID
APPWRITE_COLLECTION_ID=

# ── Cloudflare R2 (media uploads) ─────────────────────────────
# Cloudflare dashboard → R2.
#  Account ID (R2 Overview → right sidebar) — used to build the S3 endpoint.
R2_ACCOUNT_ID=
#  R2 → "Manage R2 API Tokens" → create token (Object Read & Write):
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
#  Your bucket name
R2_BUCKET=
#  Public bucket URL: enable Public access (r2.dev) or attach a custom domain.
#  e.g. https://pub-xxxxxxxxxxxx.r2.dev   (no trailing slash)
R2_PUBLIC_BASE_URL=
